# Traversal of /bin (a rootfs symlink to /system/bin) during early boot
allow hal_bootctl_default rootfs:dir r_dir_perms;

allow hal_bootctl_default sda_block_device:blk_file r_file_perms;
allow hal_bootctl_default env_block_device:blk_file rw_file_perms;
allow hal_bootctl_default kmsg_device:chr_file rw_file_perms;

allow hal_bootctl_default proc_sysrq:file w_file_perms;
allow hal_bootctl_default sysfs_tee_info:dir search;
allow hal_bootctl_default sysfs_tee_info:file rw_file_perms;

get_prop(hal_bootctl_default, boot_status_prop)
get_prop(hal_bootctl_default, usb_control_prop)
