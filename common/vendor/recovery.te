allow recovery pstorefs:dir search;

allow recovery sysfs_devices_block:dir r_dir_perms;
allow recovery sysfs_devices_block:file rw_file_perms;

# systemcontrol_static runs in recovery domain
allow recovery proc_meminfo:file r_file_perms;
allow recovery sysfs_amhdmitx:dir r_dir_perms;
allow recovery sysfs_amhdmitx:file rw_file_perms;
allow recovery sysfs_graphics_device:dir r_dir_perms;
allow recovery sysfs_graphics_device:file rw_file_perms;
allow recovery video_device:chr_file rw_file_perms;

rw_dir_file(recovery, sysfs_loop)

get_prop(recovery, aac_drc_prop)
get_prop(recovery, adaptive_haptics_prop)
set_prop(recovery, shell_prop)
set_prop(recovery, boottime_prop)
get_prop(recovery, vendor_hwc_prop)
get_prop(recovery, vendor_platform_prop)

dontaudit recovery vendor_dolby_prop:property_service set;
