binder_use(system_app, system_control)
allow system_app system_control:binder {call transfer};

allow system_app sysfs_amhdmitx:dir search;
allow system_app sysfs_status_led:dir search;
allow system_app sysfs_status_led:file rw_file_perms;
allow system_app sysfs_power:file r_file_perms;

allow system_app selinuxfs:file r_file_perms;

get_prop(system_app, system_prop)
get_prop(system_app, vendor_bluetooth_prop)
get_prop(system_app, vendor_hdmi_prop)
get_prop(system_app, vendor_media_prop)
get_prop(system_app, vendor_platform_prop)
