type ref_provision, domain;
type ref_provision_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(ref_provision)

add_hwservice(ref_provision, ref_provision_hwservice)
hwbinder_use(ref_provision)

allow ref_provision meson_display_ipc_hwservice:hwservice_manager find;
binder_call(ref_provision, hal_graphics_composer_default)

allow ref_provision cec_device:chr_file { open write };
allow ref_provision tee_device:chr_file rw_file_perms;

allow ref_provision { metadata_file mnt_user_file }:dir getattr;
allow ref_provision mnt_vendor_file:dir r_dir_perms;
allow ref_provision mnt_vendor_file:file rw_file_perms;
allow ref_provision param_tv_file:dir create_dir_perms;
allow ref_provision param_tv_file:file create_file_perms;
allow ref_provision vendor_data_file:dir { remove_name write };
allow ref_provision vendor_data_file:file { r_file_perms unlink };
allow ref_provision { vendor_shell_exec vendor_toolbox_exec }:file execute_no_trans;
allow ref_provision vfat:dir rw_dir_perms;
allow ref_provision vfat:file create_file_perms;

get_prop(ref_provision, hwservicemanager_prop)
set_prop(ref_provision, vendor_media_prop)
set_prop(ref_provision, vendor_platform_prop)
