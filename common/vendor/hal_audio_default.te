allow hal_audio_default dmabuf_system_heap_device:chr_file rw_file_perms;
allow hal_audio_default hidraw_audio_device:chr_file rw_file_perms;
allow hal_audio_default mediasync_device:chr_file rw_file_perms;

allow hal_audio_default device:dir { read open };
allow hal_audio_default mnt_vendor_file:dir search;
allow hal_audio_default mnt_vendor_file:file r_file_perms;
allow hal_audio_default oemfs:dir search;
allow hal_audio_default oemfs:file r_file_perms;
allow hal_audio_default param_tv_file:dir search;
allow hal_audio_default param_tv_file:file r_file_perms;
allow hal_audio_default sysfs_amhdmitx:dir search;
allow hal_audio_default sysfs_amhdmitx:file r_file_perms;
allow hal_audio_default sysfs_astream:dir search;
allow hal_audio_default sysfs_astream:file r_file_perms;
allow hal_audio_default sysfs_avsync:file rw_file_perms;
allow hal_audio_default sysfs_audio_cap:file r_file_perms;
allow hal_audio_default sysfs_aud_output_chs:file rw_file_perms;
allow hal_audio_default sysfs_digital_codec:file rw_file_perms;
allow hal_audio_default sysfs_cec:file rw_file_perms;
allow hal_audio_default sysfs_hidraw:dir r_dir_perms;
allow hal_audio_default sysfs_hidraw:file r_file_perms;
allow hal_audio_default sysfs_video:dir r_dir_perms;
allow hal_audio_default sysfs_video:file r_file_perms;
allow hal_audio_default sysfs_xbmc:file rw_file_perms;
allow hal_audio_default vendor_data_file:lnk_file read;

allow hal_audio_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# /vendor/lib/libnano.so, which is linked by /vendor/lib/hw/audio.primary.amlogic.so tries
# to search /data/misc/audioserver/, but it doesn't exist, so this denial doesn't matter:
# avc: denied { search } for name="audioserver" dev="mmcblk0p18" ino=169712 scontext=u:r:hal_audio_default:s0 tcontext=u:object_r:audioserver_data_file:s0 tclass=dir permissive=0
dontaudit hal_audio_default audioserver_data_file:dir search;

allow hal_audio_default self:capability { ipc_lock };

get_prop(hal_audio_default, media_prop)
get_prop(hal_audio_default, vendor_hwc_prop)
get_prop(hal_audio_default, vendor_media_prop)
get_prop(hal_audio_default, vendor_platform_prop)
set_prop(hal_audio_default, persist_audio_prop)
