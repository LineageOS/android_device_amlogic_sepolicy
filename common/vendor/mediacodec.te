allow mediacodec display_device:file r_file_perms;
allow mediacodec graphics_device:{ file chr_file } rw_file_perms;
allow mediacodec amstream_device:{ file chr_file } rw_file_perms;
allow mediacodec sysfs_amhdmitx:dir search;
allow mediacodec sysfs_amhdmitx:file r_file_perms;
allow mediacodec sysfs_amvecm:dir search;
allow mediacodec sysfs_amvecm:file rw_file_perms;
allow mediacodec sysfs_aml_media:dir r_dir_perms;
allow mediacodec sysfs_aml_media:file rw_file_perms;
allow mediacodec sysfs_audio:file r_file_perms;
allow mediacodec sysfs_graphics_device:dir r_dir_perms;
allow mediacodec sysfs_graphics_device:file r_file_perms;
allow mediacodec sysfs_media:file rw_file_perms;
allow mediacodec sysfs_video:dir r_dir_perms;
allow mediacodec sysfs_video:file rw_file_perms;
allow mediacodec media_device:chr_file rw_file_perms;
allow mediacodec media_device:file rw_file_perms;

allow mediacodec audio_device:chr_file rw_file_perms;
allow mediacodec audio_utils_device:chr_file rw_file_perms;
allow mediacodec dmabuf_heap_device:chr_file rw_file_perms;
allow mediacodec dolby_fw_device:chr_file r_file_perms;
allow mediacodec drm_device:chr_file rw_file_perms;
allow mediacodec mediaproxy_device:chr_file rw_file_perms;
allow mediacodec mediasync_device:chr_file rw_file_perms;
allow mediacodec ptsserver_device:chr_file rw_file_perms;
allow mediacodec video_device:chr_file rw_file_perms;

allow mediacodec dolby_ms12_tmpfs:filesystem getattr;
allow mediacodec dolby_ms12_tmpfs:dir search;
allow mediacodec dolby_ms12_tmpfs:file { open getattr read map execute };

allow mediacodec oemfs:dir search;
allow mediacodec oemfs:file r_file_perms;

hal_client_domain(mediacodec, hal_system_control)

get_prop(mediacodec, build_bootimage_prop);
get_prop(mediacodec, media_prop);
get_prop(mediacodec, omx_prop);
get_prop(mediacodec, vendor_hwc_prop)
get_prop(mediacodec, vendor_netflix_prop)
get_prop(mediacodec, vendor_platform_prop)
set_prop(mediacodec, vendor_media_prop);

# MS12 reads media.libplayer.dtsopt0, a legacy Amlogic player option that is never set
dontaudit mediacodec default_prop:file r_file_perms;

# DTS decoder opens /sys/class/amaudio/debug for writing and reads
# persist.sys.dtsdecopt, debug options that are never set
dontaudit mediacodec sysfs_audio:file write;
dontaudit mediacodec system_prop:file r_file_perms;
