allow vendor_init graphics_device:file setattr;
allow vendor_init proc_security:file w_file_perms;
allow vendor_init proc_watermark_boost_factor:file rw_file_perms;
allow vendor_init proc_watermark_scale_factor:file rw_file_perms;
allow vendor_init proc_vm_writable:file rw_file_perms;
allow vendor_init sysfs_graphics_device:file setattr;

allow vendor_init self:capability sys_module;

# Traversal of /bin (a rootfs symlink to /system/bin) during early boot
allow vendor_init rootfs:dir r_dir_perms;
allow vendor_init proc_cmdline:file getattr;
allow vendor_init vendor_file:system module_load;

get_prop(vendor_init, vendor_bootvideo_prop)

set_prop(vendor_init, media_prop)
set_prop(vendor_init, vendor_usb_prop)
set_prop(vendor_init, vendor_boot_prop)
set_prop(vendor_init, vendor_global_prop)
set_prop(vendor_init, vendor_hdmi_prop)
set_prop(vendor_init, vendor_media_prop)
set_prop(vendor_init, vendor_netflix_prop)
set_prop(vendor_init, vendor_shutdown_prop)
